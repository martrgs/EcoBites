<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eco_green_surface" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="112dp" android:background="@drawable/bg_header" android:gravity="bottom|center_vertical" android:orientation="horizontal" android:padding="16dp">

  <TextView
      android:layout_width="53dp"
      android:layout_height="47dp"
      android:background="@drawable/bg_card"
      android:gravity="center"
      android:text="👩🏻"
      android:textSize="24sp" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">

   <TextView
       android:id="@+id/tv_saludo_usuario"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="Hola, Mariana"
       android:textColor="#FFFFFF"
       android:textSize="30sp"
       android:textStyle="bold" />

   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="¡Qué bueno verte!"
       android:textColor="#E9F6DE"
       android:textSize="14sp" /></LinearLayout>
  <TextView android:layout_width="36dp" android:layout_height="42dp" android:gravity="center" android:text="♧" android:textColor="#FFFFFF" android:textSize="25sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
  <EditText android:id="@+id/et_buscar_producto" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/fondo_campo" android:hint="⌕  Buscar producto..." android:paddingHorizontal="12dp" android:textSize="11sp"/>
  <TextView android:layout_width="34dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_card" android:gravity="center" android:text="▦" android:textColor="#176135"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginHorizontal="16dp" android:background="@drawable/bg_soft_green" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
  <TextView android:layout_width="66dp" android:layout_height="56dp" android:gravity="center" android:text="🥑" android:textSize="42sp"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu comida también importa" android:textColor="#174A29" android:textSize="12sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Revisa la fecha de vencimiento&#10;y evita el desperdicio." android:textColor="#387044" android:textSize="9sp"/></LinearLayout>
 </LinearLayout>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="14dp" android:text="Mis productos" android:textColor="#163C23" android:textSize="15sp" android:textStyle="bold"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_lista_productos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingTop="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><Button android:id="@+id/btn_agregar_producto" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:background="@drawable/bg_primary_button" android:text="+  Agregar producto" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp"/><Button android:id="@+id/btn_ir_escaner" android:layout_width="105dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:background="@drawable/fondo_boton_borde" android:text="▣  Escanear" android:textAllCaps="false" android:textColor="#175A2B" android:textSize="11sp"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="#FFFFFF" android:gravity="center" android:orientation="horizontal">

  <TextView
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="⌂&#10;Inicio"
      android:textAlignment="center"
      android:textColor="#176F36"
      android:textSize="10sp" />

  <Button
      android:id="@+id/btn_ir_productos"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:backgroundTint="#00FFFFFF"
      android:text="▣&#10;Productos"
      android:textAllCaps="false"
      android:textColor="#385543"
      android:textSize="10sp" />

  <TextView
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="⌕&#10;Buscar"
      android:textAlignment="center"
      android:textColor="#385543"
      android:textSize="10sp" />

  <Button
      android:id="@+id/btn_ir_configuracion"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:backgroundTint="#00FFFFFF"
      android:text="☰&#10;Menú"
      android:textAllCaps="false"
      android:textColor="#385543"
      android:textSize="10sp" /></LinearLayout>
</LinearLayout>
