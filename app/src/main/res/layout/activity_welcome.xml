<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/fondo">

    <ImageView
        android:id="@+id/img_logo_bienvenida"
        android:layout_width="259dp"
        android:layout_height="98dp"
        android:layout_marginTop="36dp"
        android:adjustViewBounds="true"
        android:contentDescription="ecoBites"
        android:src="@drawable/nombreecobites" />

    <TextView
        android:id="@+id/tv_eslogan_bienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Menos desperdicio,&#10;más vida para el planeta 🌿"
        android:textColor="@color/eco_green_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/img_mascota_bienvenida"
        android:layout_width="345dp"
        android:layout_height="392dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="Mascota ecoBites"
        android:src="@drawable/mascotaecobites" />

    <Button
        android:id="@+id/btn_ir_inicio_sesion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@null"
        android:text="Iniciar sesión"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_ir_registro"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/fondo_boton_borde"
        android:backgroundTint="@null"
        android:text="Registrarse"
        android:textAllCaps="false"
        android:textColor="@color/eco_green_dark"
        android:textStyle="bold" />
</LinearLayout>
