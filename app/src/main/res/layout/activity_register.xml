<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFDF6" android:fillViewport="true">
    <LinearLayout android:id="@+id/ll_contenido_formulario" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">

        <Button
            android:id="@+id/btn_volver_registro"
            android:layout_width="139dp"
            android:layout_height="51dp"
            android:backgroundTint="#00FFFFFF"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#315D2B"
            android:textSize="20sp" />
        <ImageView android:id="@+id/img_logo_formulario" android:layout_width="160dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:adjustViewBounds="true" android:contentDescription="ecoBites" android:src="@drawable/nombre" />

        <LinearLayout android:id="@+id/ll_inicio_sesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titulo_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="¡Bienvenido!"
                android:textColor="#285A24"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tv_subtitulo_inicio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Inicia sesión para continuar" android:textColor="#4C5D49" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Nombre completo" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_nombre_inicio" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="Tu nombre y apellido" android:inputType="textPersonName" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Correo electrónico" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_correo_inicio" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="ejemplo@correo.com" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Contraseña" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_contrasena_inicio" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="••••••••" android:inputType="textPassword" android:paddingHorizontal="14dp" />
            <Button android:id="@+id/btn_iniciar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="26dp" android:backgroundTint="#5A9E36" android:text="Iniciar sesión" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
            <TextView android:id="@+id/tv_ir_registro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="¿No tienes una cuenta? Crea una" android:textColor="#315D2B" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/ll_registro" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/tv_titulo_registro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Crea tu cuenta" android:textColor="#285A24" android:textSize="29sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Completa los datos para comenzar" android:textColor="#4C5D49" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Nombre completo" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_nombre_registro" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="Tu nombre y apellido" android:inputType="textPersonName" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Correo electrónico" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_correo_registro" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="ejemplo@correo.com" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Contraseña" android:textColor="#315D2B" android:textSize="13sp" />
            <EditText android:id="@+id/et_contrasena_registro" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:background="@drawable/fondo_campo" android:hint="Mínimo 8 caracteres" android:inputType="textPassword" android:paddingHorizontal="14dp" />
            <EditText android:id="@+id/et_confirmar_contrasena" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/fondo_campo" android:hint="Confirmar contraseña" android:inputType="textPassword" android:paddingHorizontal="14dp" />
            <CheckBox android:id="@+id/cb_terminos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Acepto los términos y condiciones" android:textColor="#315D2B" android:textSize="14sp" />
            <Button android:id="@+id/btn_crear_cuenta" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:backgroundTint="#5A9E36" android:text="Crear cuenta" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
            <TextView android:id="@+id/tv_ir_inicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="¿Ya tienes cuenta? Inicia sesión" android:textColor="#315D2B" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
