<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eco_green_surface" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

  <Button
      android:id="@+id/btn_volver_registro"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:backgroundTint="#00FFFFFF"
      android:drawableTop="@drawable/ic_arrow_back"
      android:text="" />

  <ImageView
      android:id="@+id/img_logo_formulario"
      android:layout_width="237dp"
      android:layout_height="92dp"
      android:layout_gravity="center"
      android:adjustViewBounds="true"
      android:contentDescription="ecoBites"
      android:src="@drawable/nombreecobites" />
  <LinearLayout android:id="@+id/ll_inicio_sesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¡Bienvenido de nuevo!" android:textColor="#164B29" android:textSize="18sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Inicia sesión para continuar" android:textColor="#385543" android:textSize="12sp"/>
   <EditText android:id="@+id/et_correo_inicio" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="28dp" android:background="@drawable/fondo_campo" android:hint="  ✉   Correo electrónico" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <EditText android:id="@+id/et_contrasena_inicio" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/fondo_campo" android:hint="  ♙   Contraseña" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="end" android:text="¿Olvidaste tu contraseña?" android:textColor="#17703A" android:textSize="11sp" android:textStyle="bold"/>

   <Button
       android:id="@+id/btn_iniciar"
       android:layout_width="match_parent"
       android:layout_height="50dp"
       android:layout_marginTop="16dp"
       android:background="@drawable/bg_primary_button"
       android:text="Iniciar sesión"
       android:textAllCaps="false"
       android:textColor="#FFFFFF"
       android:textColorLink="#4CAF50"
       android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="────────   o   ────────" android:textColor="#799080" android:textSize="12sp"/>
   <Button android:id="@+id/btn_google_login" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/fondo_boton_borde" android:text="G   Continuar con Google" android:textAllCaps="false" android:textColor="#263B2D" android:textSize="12sp"/>
   <TextView android:id="@+id/tv_ir_registro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="¿No tienes una cuenta?   Regístrate" android:textColor="#176135" android:textSize="12sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/ll_registro" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crea tu cuenta" android:textColor="#164B29" android:textSize="18sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Únete y empieza a cuidar tus alimentos" android:textColor="#385543" android:textSize="12sp"/>
   <EditText android:id="@+id/et_nombre_registro" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="20dp" android:background="@drawable/fondo_campo" android:hint="  ♙   Nombre completo" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <EditText android:id="@+id/et_correo_registro" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:background="@drawable/fondo_campo" android:hint="  ✉   Correo electrónico" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <EditText android:id="@+id/et_contrasena_registro" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:background="@drawable/fondo_campo" android:hint="  ♙   Contraseña" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <EditText android:id="@+id/et_confirmar_contrasena" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:background="@drawable/fondo_campo" android:hint="  ♙   Confirmar contraseña" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="12sp"/>
   <CheckBox android:id="@+id/cb_terminos" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:checked="true"/>
   <Button android:id="@+id/btn_crear_cuenta" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:background="@drawable/bg_primary_button" android:text="Crear cuenta" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
   <Button android:id="@+id/btn_google_register" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/fondo_boton_borde" android:text="G   Registrarme con Google" android:textAllCaps="false" android:textColor="@color/eco_green_dark" android:textSize="12sp"/>
   <TextView android:id="@+id/tv_ir_inicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="¿Ya tienes una cuenta?   Inicia sesión" android:textColor="#176135" android:textSize="12sp"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
